<?xml version= '1.0' encoding= 'UTF-8' ?>
<definitions 
             name="TemperatureConverter"
             xmlns="http://schemas.xmlsoap.org/wsdl/"
             xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
             xmlns:inp1="http://practice.learning.com/osb/temperatureconverter/schema"
             xmlns:tns="http://practice.learning.com/osb/temperatureconverter/wsdl"
             xmlns:xsd="http://www.w3.org/2001/XMLSchema"
             targetNamespace="http://practice.learning.com/osb/temperatureconverter/wsdl">
    
    <types>
        <xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema">
            <xsd:import namespace="http://practice.learning.com/osb/temperatureconverter/schema" 
                schemaLocation="../Schemas/TemperatureConverter.xsd"/>
        </xsd:schema>
    </types>
    
    <!-- MESSAGES -->
    <message name="CelsiusToFahrenheitRequestMsg">
        <part name="parameters" element="inp1:CelsiusToFahrenheitRequest"/>
    </message>
    
    <message name="FahrenheitToCelsiusRequestMsg">
        <part name="parameters" element="inp1:FahrenheitToCelsiusRequest"/>
    </message>
    
    <message name="TemperatureResponseMsg">
        <part name="parameters"
              element="inp1:TemperatureResponse"/>
    </message>
    
    <message name="TemperatureFaultMsg">
        <part name="parameters" element="inp1:TemperatureFault"/>
    </message>
    
    <!-- PORT TYPES -->
    <portType name="TemperatureConverterPortType">
        <operation name="convertCelsiusToFahrenheit">
            <input message="tns:CelsiusToFahrenheitRequestMsg"/>
            <output message="tns:TemperatureResponseMsg"/>
            <fault name="convertCelsiusToFahrenheitfault" message="tns:TemperatureFaultMsg"/>
        </operation>
        
        <operation name="convertFahrenheitToCelsius">
            <input message="tns:FahrenheitToCelsiusRequestMsg"/>
            <output message="tns:TemperatureResponseMsg"/>
            <fault name="convertFahrenheitToCelsiusfault" message="tns:TemperatureFaultMsg"/>
        </operation>
    </portType>
    
    <binding name="TemperatureConverterBinding" type="tns:TemperatureConverterPortType">
        <soap:binding transport="http://schemas.xmlsoap.org/soap/http" style="document"/>
        <operation name="convertCelsiusToFahrenheit">
            <soap:operation soapAction="convertCelsiusToFahrenheit"/>
            <input>
                <soap:body use="literal"/>
            </input>
            <output>
                <soap:body use="literal"/>
            </output>
            <fault name="convertCelsiusToFahrenheitfault">
                <soap:fault name="convertCelsiusToFahrenheitfault" use="literal"/>
            </fault>
        </operation>
        <operation name="convertFahrenheitToCelsius">
            <soap:operation soapAction="convertFahrenheitToCelsius"/>
            <input>
                <soap:body use="literal"/>
            </input>
            <output>
                <soap:body use="literal"/>
            </output>
            <fault name="convertFahrenheitToCelsiusfault">
                <soap:fault name="convertFahrenheitToCelsiusfault" use="literal"/>
            </fault>
        </operation>
    </binding>
    
    <!-- SERVICE -->
    <service name="TemperatureConverterService">
        <port name="TemperatureConverterPort"
              binding="tns:TemperatureConverterBinding">
            <soap:address
                location="http://localhost:7101/TemperatureConverter"/>
        </port>
    </service>
</definitions>
