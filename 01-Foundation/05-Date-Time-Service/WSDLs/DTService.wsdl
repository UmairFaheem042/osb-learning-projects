<?xml version= '1.0' encoding= 'UTF-8' ?>
<wsdl:definitions
     name="DTService"
     targetNamespace="http://practice.learning.com/osb/DTService/wsdl"
     xmlns:tns="http://practice.learning.com/osb/DTService/wsdl"
     xmlns:inp1="http://practice.learning.com/osb/DTService/schema"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema"
     xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
     xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/">
    
    <wsdl:types>
        <xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema">
            <xsd:import 
                namespace="http://practice.learning.com/osb/DTService/schema" 
                schemaLocation="../Schemas/DTService.xsd"/>
        </xsd:schema>
    </wsdl:types>
    
    <wsdl:message name="DateTimeRequestMsg">
        <wsdl:part name="parameters" element="inp1:DateTimeRequest"/>
    </wsdl:message>
    <wsdl:message name="DateTimeResponseMsg">
        <wsdl:part name="parameters" element="inp1:DateTimeResponse"/>
    </wsdl:message>
    <wsdl:message name="DateTimeFaultMsg">
        <wsdl:part name="parameters" element="inp1:DateTimeFault"/>
    </wsdl:message>
    
    <wsdl:portType name="DateTimeServicesPortType">
        <wsdl:operation name="getCurrentDateTime">
            <wsdl:input message="tns:DateTimeRequestMsg"/>
            <wsdl:output message="tns:DateTimeResponseMsg"/>
            <wsdl:fault name="DateTimeFault" message="tns:DateTimeFaultMsg"/>
        </wsdl:operation>
    </wsdl:portType>
    
    <wsdl:binding name="DateTimeServicesBinding" type="tns:DateTimeServicesPortType">
        <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
        <wsdl:operation name="getCurrentDateTime">
            <soap:operation soapAction="getCurrentDateTime"/>
            <wsdl:input>
                <soap:body use="literal" namespace="http://practice.learning.com/osb/DTService/wsdl"/>
            </wsdl:input>
            <wsdl:output>
                <soap:body use="literal" namespace="http://practice.learning.com/osb/DTService/wsdl"/>
            </wsdl:output>
            <wsdl:fault name="DateTimeFault">
                <soap:fault name="DateTimeFault" use="literal"/>
            </wsdl:fault>
        </wsdl:operation>
    </wsdl:binding>
    
    
    <wsdl:service name="DateTimeServicesService">
        <wsdl:port name="DateTimeServicesPort"
              binding="tns:DateTimeServicesBinding">
            <soap:address location="http://localhost:7101/DateTimeServices"/>
        </wsdl:port>
    </wsdl:service>
</wsdl:definitions>
